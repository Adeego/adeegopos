{
  "name": "adeegopos",
  "description": "POS App",
  "version": "0.7.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run copy-static && npm run copy-env",
    "copy:ubuntu-env": "cp .env ./out/",
    "copy-env": "copy .env .\\out\\",
    "cleanup": "npm run cleanup:win && npm run cleanup:unix",
    "cleanup:win": "powershell -Command \"Get-Process | Where-Object {$_.ProcessName -match 'electron|ADEEGO'} | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 10; if (Test-Path dist) { Get-ChildItem -Path dist -Recurse | Remove-Item -Force -Recurse; Remove-Item -Path dist -Force -Recurse }; if (Test-Path out) { Remove-Item -Path out -Recurse -Force }; if (Test-Path 'node_modules\\.cache') { Remove-Item -Path 'node_modules\\.cache' -Recurse -Force }\"",
    "cleanup:unix": "rm -rf out dist && rm -rf node_modules/.cache",
    "copy-static": "cp -r ./public ./out/",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.js",
    "test:access": "node --test tests/module-access.test.js tests/staff-access-migration.test.js",
    "electron": "electron .",
    "electron-dev": "concurrently -n \"NEXT,ELECTRON\" -c \"yellow,blue\" --kill-others \"next dev -p 3333\" \"electron .\"",
    "electron-builder": "electron-builder",
    "pack": "dotenv -e .env -- next build && npm run copy-env && electron-builder --win --dir",
    "dist": "next build && electron-builder",
    "dist:lin": "dotenv -e .env -- next build && dotenv -e .env -- electron-builder",
    "publish": "dotenv -e .env -- next build && electron-builder --publish always",
    "pack:publish": "dotenv -e .env -- next build && dotenv -e .env -- electron-builder --publish always",
    "test:finance": "node --test tests/finance-journal.test.js"
  },
  "build": {
    "appId": "com.adeegoltd.adeegopos",
    "productName": "ADEEGO",
    "copyright": "adeego",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/pos2.ico",
      "publish": {
        "provider": "github",
        "owner": "Adeego",
        "repo": "adeegopos"
      }
    },
    "linux": {
      "target": "AppImage",
      "publish": {
        "provider": "github",
        "owner": "Adeego",
        "repo": "adeegopos"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Adeego"
      }
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ADEEGO",
      "uninstallDisplayName": "Uninstall ADEEGO",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@plick/electron-pos-printer": "^1.3.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-table": "^8.19.3",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "electron-log": "^5.2.0",
    "electron-serve": "^2.0.0",
    "electron-updater": "^6.1.8",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "evilscan": "^1.9.1",
    "framer-motion": "^11.11.11",
    "fuse.js": "^7.0.0",
    "grammy": "^1.39.3",
    "is-online": "^11.0.0",
    "lucide-react": "^0.424.0",
    "next": "14.2.5",
    "openai": "^4.70.2",
    "pouchdb": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "pouchdb-quick-search": "^1.3.0",
    "react": "^18",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18",
    "react-hook-form": "^7.52.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "wait-on": "^7.2.0"
  },
  "author": {
    "name": "Abdiaziz Abdullahi",
    "email": "adeegoltd@gmail.com"
  }
}
